<!-- Native adaptation of Weather.apk main.xml/header_bar.xml: header, scene,
     current conditions, and a bottom forecast panel. HTC-only classes replaced. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/weather_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#12191F">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:background="@drawable/wx_common_titlebar_center_rest">
        <TextView android:id="@+id/city" style="@style/WeatherText" android:textSize="22sp" android:textStyle="bold" android:paddingStart="16dp" android:paddingEnd="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end"/>
        <ImageButton android:id="@+id/fullscreen" android:layout_width="44dp" android:layout_height="match_parent" android:src="@drawable/wx_common_icon_titlebar_full_screen_rest" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Full screen weather animation"/>
        <ImageButton android:id="@+id/refresh" android:layout_width="48dp" android:layout_height="match_parent" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/wx_common_icon_titlebar_updates_rest" android:contentDescription="Refresh weather"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/weather_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/now_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <FrameLayout android:id="@+id/current_scene" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <dev.sense.weather.WeatherSceneView android:id="@+id/scene" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Weather animation"/>
                <LinearLayout android:id="@+id/condition_overlay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:orientation="vertical" android:gravity="end" android:padding="16dp">
                    <TextView android:id="@+id/temperature" style="@style/WeatherText" android:textSize="62sp" android:shadowColor="#CC000000" android:shadowRadius="3" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/range" style="@style/WeatherText" android:textSize="15sp" android:shadowColor="#CC000000" android:shadowRadius="3" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/condition" style="@style/WeatherText" android:textSize="18sp" android:shadowColor="#CC000000" android:shadowRadius="3" android:maxLines="2" android:gravity="end" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:id="@+id/now_periods" android:layout_width="match_parent" android:layout_height="160dp" android:orientation="horizontal" android:background="#E7EFF2"/>
        </LinearLayout>
        <dev.sense.weather.HourlyForecastView android:id="@+id/hourly_chart" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
        <ScrollView android:id="@+id/weather_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/forecast_title" style="@style/WeatherText" android:textSize="23sp" android:textStyle="bold" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <LinearLayout android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <LinearLayout android:id="@+id/provider_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="24dp" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/attribution" style="@style/WeatherText" android:text="Open-Meteo · GeoNames" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/status" style="@style/WeatherText" android:textSize="11sp" android:gravity="end" android:singleLine="true" android:ellipsize="end" android:maxWidth="150dp" android:paddingStart="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="44dp" android:layout_margin="6dp" android:orientation="horizontal"/>
</LinearLayout>
