<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="48dp">
    <ImageView android:layout_width="match_parent" android:layout_height="14dp" android:layout_gravity="bottom" android:src="@drawable/msg_widget_footer" android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="144dp" android:layout_height="48dp" android:layout_gravity="center" android:orientation="horizontal" android:background="@drawable/msg_widget_buttons">
        <FrameLayout android:id="@+id/widget_inbox" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="Open Messages">
            <ImageView android:layout_width="28dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/msg_widget_list" android:scaleType="fitCenter" android:contentDescription="@null" />
            <TextView android:id="@+id/widget_unread" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:layout_marginEnd="7dp" android:textColor="#ffffff" android:textSize="11sp" android:gravity="center" android:background="@drawable/msg_widget_badge" />
        </FrameLayout>
        <ImageView android:id="@+id/widget_compose" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:src="@drawable/msg_widget_add" android:scaleType="centerInside" android:padding="13dp" android:contentDescription="New message" />
    </LinearLayout>
</FrameLayout>
