<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/msg_widget_card" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="#222222" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#666666" android:maxLines="2" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_photo" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/msg_widget_msg_default_photo" android:scaleType="centerCrop" android:contentDescription="@null" />
    </LinearLayout>
    <TextView android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textSize="17sp" android:textColor="#222222" android:paddingTop="12dp" android:maxLines="12" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_reply" android:layout_width="44dp" android:layout_height="40dp" android:src="@drawable/msg_widget_reply" android:scaleType="centerInside" android:contentDescription="Reply" />
        <TextView android:id="@+id/widget_position" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="12sp" android:textColor="#666666" android:gravity="center" />
        <TextView android:layout_width="44dp" android:layout_height="40dp" android:text="Open" android:textSize="12sp" android:textColor="#666666" android:gravity="center" />
    </LinearLayout>
</LinearLayout>
