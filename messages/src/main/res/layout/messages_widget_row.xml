<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:padding="5dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/widget_photo" android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/msg_widget_msg_default_photo" android:scaleType="centerCrop" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="8dp" android:orientation="vertical">
        <TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#eeeeee" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#bcbcbc" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="66dp" android:paddingStart="5dp" android:textSize="11sp" android:textColor="#dddddd" android:gravity="end" android:maxLines="2" />
</LinearLayout>
